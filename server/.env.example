# Django Configuration
DJANGO_SECRET_KEY=transmart-your-secret-key
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=your-backend.up.railway.app

# MySQL Database
# Note: Railway automatically provides a DATABASE_URL. 
# You only need these if manually configuring a separate MySQL service.
MYSQL_DATABASE=transport
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# React Frontend Origin (for CORS)
CORS_ALLOWED_ORIGINS=https://transmart-frontend.vercel.app

# PayMongo GCash Sandbox Settings
PAYMONGO_SECRET_KEY=your-paymongo-secret-key
FRONTEND_URL=http://localhost:3000


